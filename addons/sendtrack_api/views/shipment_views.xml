<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sendtrack_shipment_list" model="ir.ui.view">
        <field name="name">sendtrack.shipment.list</field>
        <field name="model">sendtrack.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments">
                <field name="name"/>
                <field name="tracking_code"/>
                <field name="sender_id"/>
                <field name="receiver_id"/>
                <field name="weight"/>
                <field name="status"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_sendtrack_shipment_form" model="ir.ui.view">
        <field name="name">sendtrack.shipment.form</field>
        <field name="model">sendtrack.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_transit,delivered,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="tracking_code" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Parties">
                            <field name="sender_id"/>
                            <field name="receiver_id"/>
                        </group>
                        <group string="Details">
                            <field name="weight"/>
                            <field name="delivery_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional shipment information..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sendtrack_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">sendtrack.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shipment!
            </p>
        </field>
    </record>
</odoo>
