<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sendtrack_ticket_list" model="ir.ui.view">
        <field name="name">sendtrack.ticket.list</field>
        <field name="model">sendtrack.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="shipment_id"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_sendtrack_ticket_form" model="ir.ui.view">
        <field name="name">sendtrack.ticket.form</field>
        <field name="model">sendtrack.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="open,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Ticket Subject..."/>
                        </h2>
                    </div>
                    <group>
                        <group string="Customer Information">
                            <field name="partner_id"/>
                            <field name="shipment_id"/>
                        </group>
                        <group string="Ticket Properties">
                            <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Issue details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sendtrack_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">sendtrack.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first support ticket!
            </p>
        </field>
    </record>
</odoo>
